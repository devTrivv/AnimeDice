local tpThread = nil

createGui()

buttonRef.MouseButton1Click:Connect(function()
    autoHopEnabled = not autoHopEnabled
    updateGuiStatus()
    
    if autoHopEnabled then
        setStatus("Coletando...", FOUND_COLOR)
        
        tpThread = task.spawn(function()
            while autoHopEnabled do
                local HalloweenFolder = Workspace:FindFirstChild("Halloween")
                local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local hrp = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChild("Humanoid")

                if HalloweenFolder and hrp and humanoid and humanoid.Health > 0 then
                    local casas = HalloweenFolder:GetChildren()
                    
                    for _, casa in ipairs(casas) do
                        if not autoHopEnabled then break end
                        
                        if string.find(casa.Name, "HouseForTrickOrTreating") then
                            local door = casa:FindFirstChild("DoorOpener")
                            if door then
                                pcall(function()
                                    hrp.CFrame = door:GetPivot()
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                    hrp.AssemblyAngularVelocity = Vector3.zero
                                end)
                                task.wait(0.2)
                            end
                        end
                    end
                else
                    task.wait(0.5)
                end
            end
        end)
    else
        setStatus("Parado", Color3.fromRGB(180, 90, 120))
    end
end)
