local function refreshQuirkRow(row, q)
    local isLocked = quirkLocked[q] == true
    local isSelected = quirkSelected[q] == true
    local rowStroke = row:FindFirstChildOfClass("UIStroke")
    local btn, lockBtn
    for _, c in ipairs(row:GetChildren()) do
        if c:IsA("TextButton") then
            if c.Name == "SelectBtn" then
                btn = c
            elseif c.Name == "LockBtn" then
                lockBtn = c
            end
        end
    end
    if isLocked then
        tween(row, { BackgroundColor3 = BG_MAIN_2 }, 0.15)
        if rowStroke then tween(rowStroke, { Color = STROKE, Transparency = 0.6 }, 0.15) end
        if btn then tween(btn, { TextColor3 = TEXT_DIM, TextTransparency = 0.4 }, 0.15) end
        if lockBtn then
            local lockStroke = lockBtn:FindFirstChildOfClass("UIStroke")
            tween(lockBtn, { BackgroundColor3 = RED_DARK, TextColor3 = RED }, 0.15)
            if lockStroke then tween(lockStroke, { Color = RED, Transparency = 0.3 }, 0.15) end
            lockBtn.Text = "🔒"
        end
        quirkSelected[q] = false
    else
        if btn then tween(btn, { TextTransparency = 0 }, 0.15) end
        if lockBtn then
            local lockStroke = lockBtn:FindFirstChildOfClass("UIStroke")
            tween(lockBtn, { BackgroundColor3 = BG_MAIN_2, TextColor3 = TEXT_DIM }, 0.15)
            if lockStroke then tween(lockStroke, { Color = STROKE, Transparency = 0.5 }, 0.15) end
            lockBtn.Text = "🔓"
        end
        if isSelected then
            tween(row, { BackgroundColor3 = BG_BTN_ON }, 0.15)
            if rowStroke then tween(rowStroke, { Color = GREEN, Transparency = 0.2 }, 0.15) end
            if btn then tween(btn, { TextColor3 = GREEN }, 0.15) end
        else
            tween(row, { BackgroundColor3 = BG_BTN }, 0.15)
            if rowStroke then tween(rowStroke, { Color = STROKE, Transparency = 0.5 }, 0.15) end
            if btn then tween(btn, { TextColor3 = TEXT_DIM }, 0.15) end
        end
    end
end

