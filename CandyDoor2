function classificarPrioridade(dados)
    local q = obterQuirkDoBoneco(dados)
    local semQuirk = (q == nil or q == "" or q == "Sem Quirk" or q == "nil" or q == "None")
    local naLista = false
    for _, nome in ipairs(QUIRKS_ROLL_LIST) do
        if q and q:lower() == nome:lower() then
            naLista = true
            break
        end
    end
    if naLista then
        if CheckQuirkMatch(q) then
            return 3
        end
        return 2
    end
    if semQuirk then
        return 0
    end
    return 1
end

function AtualizarListaQuirk()
    if not MatrizSalva then return end
    local filtro = QuirkSearchBox.Text:lower()
    local alvo = {}
    local alvoSet = {}

    for chave, dados in pairs(MatrizSalva) do
        if type(dados) == "table" then
            local ehUnit = false
            for k, v in pairs(dados) do
                if tostring(k):lower() == "kind" and tostring(v) == "Unit" then
                    ehUnit = true
                    break
                end
            end
            if ehUnit then
                local uuid = dados.key or dados.Key or (type(chave) == "string" and chave) or dados.Id
                local nome = dados.name or dados.Name or "?"
                if uuid and (filtro == "" or nome:lower():find(filtro, 1, true)) then
                    local prioridade = classificarPrioridade(dados)
                    if uuid == quirkBonecoRolandoAgora then
                        prioridade = -1
                    end
                    table.insert(alvo, {
                        uuid = uuid,
                        dados = dados,
                        nome = nome,
                        prioridade = prioridade
                    })
                    alvoSet[uuid] = true
                end
            end
        end
    end

    table.sort(alvo, function(a, b)
        if a.prioridade ~= b.prioridade then
            return a.prioridade < b.prioridade
        end
        return a.nome:lower() < b.nome:lower()
    end)

    for uuid, item in pairs(QuirkItemMap) do
        if not alvoSet[uuid] then
            item.frame:Destroy()
            QuirkItemMap[uuid] = nil
        end
    end

    for _, info in ipairs(alvo) do
        local existente = QuirkItemMap[info.uuid]
        if not existente then
            QuirkItemMap[info.uuid] = criarItemQuirk(info.uuid, info.dados, info.nome)
        else
            existente.dados = info.dados
            existente.atualizar()
        end
    end

    table.clear(QuirkListaItens)
    for i, info in ipairs(alvo) do
        local item = QuirkItemMap[info.uuid]
        if item then
            item.frame.LayoutOrder = i
            table.insert(QuirkListaItens, item)
        end
    end
end

