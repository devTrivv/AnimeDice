CONFIG_FILE = "AutoHalloween_Config.json"

function ConfigPath()
    if writefile then
        return CONFIG_FILE
    end
    return nil
end

function SerializarConfig()
    local cfg = {
        AutoLoad = btnAutoLoadToggle:GetAttribute("Active") == true,
        AntiAFK = AntiAFKAtivo,
        Quests = {},
        Quirk = {
            Selected = {},
            Locked = {},
            Bonecos = {},
            BonecosOrder = {}
        },
        Tower = {
            Halloween = {},
            Normal = {}
        },
        Roll = {
            Grades = {},
            Traits = {},
            Bonecos = {}
        }
    }
    for _, q in ipairs(questDefs) do
        cfg.Quests[q.id] = {
            Active = questButtons[q.id].btn:GetAttribute("Active") == true,
            Manual = Manual[q.id] == true
        }
    end
    for k, v in pairs(quirkSelected) do
        if v then table.insert(cfg.Quirk.Selected, k) end
    end
    for k, v in pairs(quirkLocked) do
        if v then table.insert(cfg.Quirk.Locked, k) end
    end
    for uuid, v in pairs(selectedBonecosQuirk) do
        if v then table.insert(cfg.Quirk.Bonecos, uuid) end
    end
    for _, uuid in ipairs(selectedBonecosQuirkOrder) do
        table.insert(cfg.Quirk.BonecosOrder, uuid)
    end
    for k, v in pairs(SelectedHalloween) do
        if v then table.insert(cfg.Tower.Halloween, k) end
    end
    for k, v in pairs(SelectedNormal) do
        if v then table.insert(cfg.Tower.Normal, k) end
    end
    for k, v in pairs(gradeSelected) do
        if v then table.insert(cfg.Roll.Grades, k) end
    end
    for k, v in pairs(traitSelected) do
        if v then table.insert(cfg.Roll.Traits, k) end
    end
    for uuid, v in pairs(selectedBonecos) do
        if v then table.insert(cfg.Roll.Bonecos, uuid) end
    end
    return cfg
end

function SalvarConfig(silencioso)
    local path = ConfigPath()
    if not path then
        if not silencioso then
            mostrarNotificacao("Executor sem writefile!", RED)
        end
        return false
    end
    local cfg = SerializarConfig()
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(cfg)
    end)
    if not ok then
        if not silencioso then
            mostrarNotificacao("Falha ao codificar config.", RED)
        end
        return false
    end
    local okWrite = pcall(function()
        writefile(path, encoded)
    end)
    if okWrite then
        if not silencioso then
            mostrarNotificacao("Config salva!", GREEN)
        end
        return true
    else
        if not silencioso then
            mostrarNotificacao("Falha ao salvar config.", RED)
        end
        return false
    end
end

function AplicarConfig(cfg)
    if not cfg then return end
    if cfg.AntiAFK ~= nil then
        AntiAFKAtivo = cfg.AntiAFK
        btnAntiAFK:SetAttribute("Active", AntiAFKAtivo)
        if AntiAFKAtivo then
            btnAntiAFK.Text = "ANTI-AFK: ON"
            tween(btnAntiAFK, { BackgroundColor3 = BG_BTN_ON, TextColor3 = GREEN }, 0.2)
            tween(btnAntiAFKStroke, { Color = GREEN, Transparency = 0.2 }, 0.2)
        else
            btnAntiAFK.Text = "ANTI-AFK: OFF"
            tween(btnAntiAFK, { BackgroundColor3 = BG_BTN, TextColor3 = TEXT_DIM }, 0.2)
            tween(btnAntiAFKStroke, { Color = STROKE, Transparency = 0.45 }, 0.2)
        end
    end
    if cfg.AutoLoad ~= nil then
        btnAutoLoadToggle:SetAttribute("Active", cfg.AutoLoad)
        if cfg.AutoLoad then
            btnAutoLoadToggle.Text = "AUTO LOAD CONFIG: ON"
            tween(btnAutoLoadToggle, { BackgroundColor3 = BG_BTN_ON, TextColor3 = GREEN }, 0.2)
            tween(btnAutoLoadStroke, { Color = GREEN, Transparency = 0.2 }, 0.2)
        else
            btnAutoLoadToggle.Text = "AUTO LOAD CONFIG: OFF"
            tween(btnAutoLoadToggle, { BackgroundColor3 = BG_BTN, TextColor3 = TEXT_DIM }, 0.2)
            tween(btnAutoLoadStroke, { Color = STROKE, Transparency = 0.45 }, 0.2)
        end
    end
    if type(cfg.Quests) == "table" then
        for id, info in pairs(cfg.Quests) do
            if questButtons[id] and type(info) == "table" then
                Manual[id] = info.Manual == true
                if info.Active == true then
                    if id == "doors" then
                        SetDoors(true, info.Manual == true)
                    elseif id == "complete" then
                        if not isCompleteEnabled then
                            isCompleteEnabled = true
                            updateToggleVisual(questButtons.complete, true, "AUTO COMPLETE: ON", "AUTO COMPLETE: OFF")
                            startSmartQuest()
                        end
                    elseif id == "claim" then
                        if not isClaimEnabled then
                            isClaimEnabled = true
                            updateToggleVisual(questButtons.claim, true, "AUTO CLAIM: ON", "AUTO CLAIM: OFF")
                            startSmartQuest()
                        end
                    elseif id == "pumpkin" then
                        SetPumpkinRoll(true, info.Manual == true)
                        LoopPumpkinRoll()
                    elseif id == "potion" then
                        SetPotion(true, info.Manual == true)
                        LoopPotion()
                    end
                end
            end
        end
    end
    if type(cfg.Quirk) == "table" then
        if type(cfg.Quirk.Selected) == "table" then
            for _, q in ipairs(cfg.Quirk.Selected) do
                quirkSelected[q] = true
            end
            if AtualizarListaQuirk then AtualizarListaQuirk() end
        end
        if type(cfg.Quirk.Locked) == "table" then
            for _, q in ipairs(cfg.Quirk.Locked) do
                quirkLocked[q] = true
            end
            if AtualizarListaQuirk then AtualizarListaQuirk() end
        end
        if type(cfg.Quirk.Bonecos) == "table" then
            for _, uuid in ipairs(cfg.Quirk.Bonecos) do
                selectedBonecosQuirk[uuid] = true
            end
            if AtualizarListaQuirk then AtualizarListaQuirk() end
        end
        if type(cfg.Quirk.BonecosOrder) == "table" then
            selectedBonecosQuirkOrder = {}
            for _, uuid in ipairs(cfg.Quirk.BonecosOrder) do
                table.insert(selectedBonecosQuirkOrder, uuid)
            end
        end
    end
    if type(cfg.Tower) == "table" then
        if type(cfg.Tower.Halloween) == "table" then
            for _, name in ipairs(cfg.Tower.Halloween) do
                if SelectedHalloween[name] == nil and HalloweenButtons[name] then
                    SelectedHalloween[name] = true
                    SelectedTowers[name] = true
                    setItemVisual(HalloweenButtons[name], true)
                end
            end
        end
        if type(cfg.Tower.Normal) == "table" then
            for _, name in ipairs(cfg.Tower.Normal) do
                if SelectedNormal[name] == nil and NormalButtons[name] then
                    SelectedNormal[name] = true
                    SelectedTowers[name] = true
                    setItemVisual(NormalButtons[name], true)
                end
            end
        end
    end
    if type(cfg.Roll) == "table" then
        if type(cfg.Roll.Grades) == "table" then
            for _, g in ipairs(cfg.Roll.Grades) do
                if gradeSelected[g] == nil then
                    gradeSelected[g] = true
                end
            end
        end
        if type(cfg.Roll.Traits) == "table" then
            for _, t in ipairs(cfg.Roll.Traits) do
                if traitSelected[t] == nil then
                    traitSelected[t] = true
                end
            end
        end
        if type(cfg.Roll.Bonecos) == "table" then
            for _, uuid in ipairs(cfg.Roll.Bonecos) do
                selectedBonecos[uuid] = true
            end
            if AtualizarLista then AtualizarLista() end
        end
    end
end

function CarregarConfig(silencioso)
    local path = ConfigPath()
    if not path then
        if not silencioso then
            mostrarNotificacao("Executor sem readfile!", RED)
        end
        return false
    end
    if not isfile or not isfile(path) then
        if not silencioso then
            mostrarNotificacao("Nenhuma config salva.", YELLOW)
        end
        return false
    end
    local ok, content = pcall(function()
        return readfile(path)
    end)
    if not ok or not content then
        if not silencioso then
            mostrarNotificacao("Falha ao ler config.", RED)
        end
        return false
    end
    local okDecode, cfg = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not okDecode or type(cfg) ~= "table" then
        if not silencioso then
            mostrarNotificacao("Config invalida.", RED)
        end
        return false
    end
    AplicarConfig(cfg)
    if not silencioso then
        mostrarNotificacao("Config carregada!", GREEN)
    end
    return true
end

