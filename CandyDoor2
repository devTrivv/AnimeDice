function CheckGradeMatch(g)
    if not g or g == "" then
        return false
    end
    for k, sel in pairs(gradeSelected) do
        if sel then
            local simboloAlvo = TabelaSymbols[k] or k
            if g == simboloAlvo or string.find(g, simboloAlvo, 1, true) then
                return true
            end
            if string.find(g, k, 1, true) then
                return true
            end
        end
    end
    return false
end

function CheckTraitMatch(t)
    for k, sel in pairs(traitSelected) do
        if sel and t:lower():find(k:lower(), 1, true) then
            return true
        end
    end
    return false
end

