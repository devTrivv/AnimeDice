        local ps = ReplicatedStorage:WaitForChild("Network"):WaitForChild("PumpkinDiceService", 5)
        local rr = ps and ps:WaitForChild("RF", 5):WaitForChild("Roll", 5)
        while States.PumpkinRoll do
            if (pumpkinQuestAtiva or hauntedNightAtiva) and rr then
                pcall(function()
                    rr:InvokeServer(5)
                end)
            end
            task.wait(0.1)
        end
    end)
end

function LoopNormalRoll()
    task.spawn(function()
        local rs = ReplicatedStorage:WaitForChild("Network"):WaitForChild("RollService", 5)
        local rf = rs and rs:FindFirstChild("RF", 5)
        local ev = rf and rf:FindFirstChild("RollDice", 5)
        while States.NormalRoll do
            if ev then
                pcall(function()
                    ev:InvokeServer()
                end)
            end
            task.wait(0.15)
        end
    end)
end

function LoopPotion()
    task.spawn(function()
        local bs = ReplicatedStorage:WaitForChild("Network"):WaitForChild("BoostService", 5)
        local ur = bs and bs:WaitForChild("RE", 5):WaitForChild("Use", 5)
        while States.Potion do
            if ur then
                pcall(function()
                    ur:FireServer("Pumpkin Pot II")
                    ur:FireServer("Pumpkin Pot III")
                    ur:FireServer("Candy Pot II")
                    ur:FireServer("Candy Pot III")
                end)
            end
            task.wait(0.5)
        end
    end)
end

function dispararRemoteClaim(tipo, categoria, nomePasta)
    local Remote = ReplicatedStorage:FindFirstChild("Network") and ReplicatedStorage.Network:FindFirstChild("HalloweenQuestService") and ReplicatedStorage.Network.HalloweenQuestService:FindFirstChild("RE") and ReplicatedStorage.Network.HalloweenQuestService.RE:FindFirstChild("Claim")
    if Remote then
        local catSingular = string.gsub(categoria, "s$", "")
        if catSingular ~= categoria then
            setStatus("Claim: " .. nomePasta, GREEN)
            pcall(function()
                Remote:FireServer(tipo, categoria)
                Remote:FireServer(tipo, catSingular)
            end)
        else
            setStatus("Claim: " .. nomePasta, GREEN)
            pcall(function()
                Remote:FireServer(tipo, categoria)
            end)
        end
    end
end

