    task.spawn(function()
        setStatus("Rolando...", ACCENT_GLOW)

        local fila = {}
        local filaSet = {}
        for _, uuid in ipairs(selectedBonecosQuirkOrder) do
            if selectedBonecosQuirk[uuid] and not filaSet[uuid] then
                table.insert(fila, uuid)
                filaSet[uuid] = true
            end
        end
        for uuid, sel in pairs(selectedBonecosQuirk) do
            if sel and not filaSet[uuid] then
                table.insert(fila, uuid)
                filaSet[uuid] = true
            end
        end

        if #fila == 0 then
            isAutoQuirkRunning = false
            updateToggleVisual(quirkRunData, false, "QUIRK: ON", "QUIRK: OFF")
            return
        end

        local function acharDados(uuid)
            for _, d in pairs(MatrizSalva or {}) do
                if type(d) == "table" and (d.key == uuid or d.Id == uuid) then
                    return d
                end
            end
            return nil
        end

        for _, uuid in ipairs(fila) do
            if not isAutoQuirkRunning then break end
            if not selectedBonecosQuirk[uuid] then continue end

            local dados = acharDados(uuid)
            if not dados then continue end

            local nomeBoneco = dados.name or dados.Name or "?"

            if CheckQuirkMatch(obterQuirkDoBoneco(dados)) then
                setStatus("Ja tem: " .. nomeBoneco, GREEN)
                continue
            end

            setStatus("Rolando: " .. nomeBoneco, ACCENT_GLOW)
            quirkBonecoRolandoAgora = uuid
            if AtualizarListaQuirk then AtualizarListaQuirk() end

            while isAutoQuirkRunning and selectedBonecosQuirk[uuid] do
                dados = acharDados(uuid)
                if not dados then break end

                local q2 = obterQuirkDoBoneco(dados)
                if CheckQuirkMatch(q2) then
                    setStatus("Quirk alvo! " .. nomeBoneco, GREEN)
                    mostrarNotificacao("Quirk alvo em " .. nomeBoneco .. "!", GREEN)
                    break
