    grad.Parent = textLabel
    local time = 0
    local conn = RunService.RenderStepped:Connect(function(dt)
        time = time + dt
        local hueOffset = (time * 0.3) % 1
        local cs = {}
        for i = 0, 5 do
            local hue = (i / 6 + hueOffset) % 1
            table.insert(cs, ColorSequenceKeypoint.new(i / 5, Color3.fromHSV(hue, 0.8, 1)))
        end
        grad.Color = ColorSequence.new(cs)
    end)
    table.insert(rainbowConnections, conn)
end

