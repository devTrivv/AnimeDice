autoRotateData = makeToggleButton(PageTower, "AUTO ROTATE TOWER: OFF", 162, 24)

autoRotateData.btn.MouseButton1Click:Connect(function()
    if isAutoRotateTowerRunning then
        isAutoRotateTowerRunning = false
        updateToggleVisual(autoRotateData, false, "AUTO ROTATE TOWER: ON", "AUTO ROTATE TOWER: OFF")
        setStatus("Auto Tower Desligado.", TEXT_DIM)
        if cancelTowerRF then
            pcall(function()
                cancelTowerRF:InvokeServer()
            end)
        end
        return
    end
    isAutoRotateTowerRunning = true
    updateToggleVisual(autoRotateData, true, "AUTO ROTATE TOWER: ON", "AUTO ROTATE TOWER: OFF")
    task.spawn(function()
        while isAutoRotateTowerRunning do
            local l = getListaTowersSelecionadas()
            if #l == 0 then
                setStatus("Nenhuma Tower selecionada!", RED)
                task.wait(2)
                continue
            end
            rotacaoTowerIndex = (rotacaoTowerIndex % #l) + 1
            local ct = l[rotacaoTowerIndex]
            if not completeTowerRF or not cancelTowerRF then
                setStatus("Erro nos Remotes da Tower.", RED)
                isAutoRotateTowerRunning = false
                updateToggleVisual(autoRotateData, false, "AUTO ROTATE TOWER: ON", "AUTO ROTATE TOWER: OFF")
                break
            end
            local ptr = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Towers"):WaitForChild("RF"):WaitForChild("PlayTower")
            setStatus("Entrando: " .. ct, ACCENT_GLOW)
            local entrou = false
            local tentativas = 0
            while isAutoRotateTowerRunning and not entrou and tentativas < 10 do
                tentativas = tentativas + 1
                pcall(function()
                    entrou = (ptr:InvokeServer(ct) == true)
                end)
                if not entrou then
                    setStatus("Recusado " .. tentativas .. "/10: " .. ct, YELLOW)
                    task.wait(1)
                end
            end
            if not entrou then
                setStatus("Bloqueada: " .. ct, RED)
                task.wait(2)
                continue
            end
            task.wait(2)
            setStatus("Lutando: " .. ct, YELLOW)
            torreFinalizada = false
            ultimoFloor = 0
            achouAndar = false
            while isAutoRotateTowerRunning and not torreFinalizada do
                pcall(function()
                    completeTowerRF:InvokeServer()
                end)
                if achouAndar then
                    achouAndar = false
                    setStatus("Floor " .. ultimoFloor, GREEN)
                end
                task.wait(1.5)
            end
            if isAutoRotateTowerRunning then
                setStatus("Torre finalizada...", YELLOW)
                pcall(function()
                    cancelTowerRF:InvokeServer()
                end)
                task.wait(1)
            end
        end
    end)
end)

