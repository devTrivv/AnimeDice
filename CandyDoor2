function checkHauntedPotion()
    if not workspace:FindFirstChild("Haunted Night") then
        return
    end
    if not States.PumpkinRoll then
        return
    end
    pcall(function()
        local bb = LocalPlayer.PlayerGui.Root.HUD.BuffBar
        local ur = ReplicatedStorage.Network.BoostService.RE.Use
        if not bb:FindFirstChild("Boost_Haunted Potion") then
            ur:FireServer("Haunted Potion")
            setStatus("Poção Haunted Usada!", ACCENT_GLOW)
        end
        if not buffMonitorConnection then
            buffMonitorConnection = bb.ChildRemoved:Connect(function(c)
                if c.Name == "Boost_Haunted Potion" then
                    task.wait(0.5)
                    checkHauntedPotion()
                end
            end)
        end
    end)
end

function ProcessarHauntedNight()
    hauntedNightAtiva = workspace:FindFirstChild("Haunted Night") ~= nil
    if hauntedNightAtiva then
        setStatus("Haunted Night Detectado!", ACCENT_GLOW)
        checkHauntedPotion()
    else
        setStatus("Haunted Night Sumiu.", TEXT_DIM)
        if buffMonitorConnection then
            buffMonitorConnection:Disconnect()
            buffMonitorConnection = nil
        end
    end
end

