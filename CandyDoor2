function AvaliarScrollingFrame(scroll)
    if not isCompleteEnabled and not isClaimEnabled then
        return
    end
    local pD, pP, pN, pPot = false, false, false, false
    if not EstaNoEvento() then
        if States.Doors then
            SetDoors(false, false)
        end
        return
    end
    for _, mf in ipairs(scroll:GetChildren()) do
        if mf:IsA("Frame") then
            local bc = mf:FindFirstChild("Buttons") and mf.Buttons:FindFirstChild("Claim")
            if bc then
                local inf = bc:FindFirstChild("Frame") and bc.Frame:FindFirstChild("Info")
                local txt = inf and inf:FindFirstChild("TextLabel") and inf.TextLabel.Text
                if isClaimEnabled and bc.GuiState == Enum.GuiState.Idle and txt ~= "Claimed" and not bc:GetAttribute("AutoClaimed") then
                    bc:SetAttribute("AutoClaimed", true)
                    local tipo, categoria = string.match(mf.Name, "^(Daily)") or string.match(mf.Name, "^(Hourly)"), string.gsub(mf.Name, "^(Daily)", ""):gsub("^(Hourly)", "")
                    if TraduzirMissao[mf.Name] then
                        tipo = TraduzirMissao[mf.Name][1]
                        categoria = TraduzirMissao[mf.Name][2]
                    end
                    if tipo and categoria then
                        dispararRemoteClaim(tipo, categoria, mf.Name)
                    end
                end
                if isCompleteEnabled and bc.GuiState == Enum.GuiState.NonInteractable and txt == "Claim" then
                    local qg = mf:FindFirstChild("QuestGoal")
                    if qg and qg:IsA("TextLabel") and qg.Text ~= "" then
                        local normalizado = string.lower(qg.Text):gsub("[^%a%s]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                        local temPumpkin = string.find(normalizado, "pumpkin") ~= nil
                        local temDice = string.find(normalizado, "dice") ~= nil or string.find(normalizado, "roll") ~= nil
                        if string.find(normalizado, "door") then
                            pD = true
                        elseif temPumpkin and temDice then
                            pP = true
                        elseif temDice then
                            pN = true
                        elseif string.find(normalizado, "drink") or string.find(normalizado, "potion") then
                            pPot = true
                        end
                    end
                end
            end
        end
    end
    pumpkinQuestAtiva = pP and isCompleteEnabled
    if isCompleteEnabled then
        if pD and not States.Doors then
            SetDoors(true, false)
        elseif not pD and States.Doors and not Manual.Doors then
            SetDoors(false, false)
        end
        if pN and not States.NormalRoll then
            States.NormalRoll = true
            LoopNormalRoll()
        elseif not pN and States.NormalRoll and not Manual.NormalRoll then
            States.NormalRoll = false
        end
        if pPot and not States.Potion then
            SetPotion(true, false)
            LoopPotion()
        elseif not pPot and States.Potion and not Manual.Potion then
            SetPotion(false, false)
        end
    end
end

function startSmartQuest()
    task.spawn(function()
        pcall(function()
            local pGui = LocalPlayer:WaitForChild("PlayerGui", 10)
            if not pGui then
                return
            end
            local sfq = pGui.Root.Menus.HalloweenQuests:WaitForChild("Quests", 10):WaitForChild("ScrollingFrame", 5)
            if not sfq then
                return
            end
            sfq.ChildAdded:Connect(function()
                task.wait(0.5)
                AvaliarScrollingFrame(sfq)
            end)
            sfq.ChildRemoved:Connect(function()
                task.wait(0.5)
                AvaliarScrollingFrame(sfq)
            end)
            AvaliarScrollingFrame(sfq)
            task.spawn(function()
                while isCompleteEnabled or isClaimEnabled do
                    task.wait(1)
                    if sfq and sfq.Parent then
                        AvaliarScrollingFrame(sfq)
                    end
                end
            end)
        end)
    end)
end

