function criarBotaoItem(parent, texto, layoutOrder, onToggle)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -2, 0, 22)
    b.BackgroundColor3 = BG_BTN
    b.Text = texto
    b.TextColor3 = TEXT_DIM
    b.TextSize = 8
    b.Font = Enum.Font.GothamBold
    b.TextXAlignment = Enum.TextXAlignment.Center
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = 5
    b.LayoutOrder = layoutOrder
    b.Parent = parent
    makeCorner(b, 7)
    local s = makeStroke(b, STROKE, 1, 0.5)
    b.MouseEnter:Connect(function()
        if not b:GetAttribute("Active") then
            tween(b, { BackgroundColor3 = BG_BTN_HOVER }, 0.15)
        else
            tween(b, { BackgroundColor3 = BG_BTN_ON_HOV }, 0.15)
        end
    end)
    b.MouseLeave:Connect(function()
        if not b:GetAttribute("Active") then
            tween(b, { BackgroundColor3 = BG_BTN }, 0.15)
        else
            tween(b, { BackgroundColor3 = BG_BTN_ON }, 0.15)
        end
    end)
    local data = { btn = b, str = s }
    b.MouseButton1Click:Connect(function()
        onToggle(data)
    end)
    return data
end

function setItemVisual(data, isOn)
    data.btn:SetAttribute("Active", isOn)
    if isOn then
        tween(data.btn, { TextColor3 = GREEN, BackgroundColor3 = BG_BTN_ON }, 0.15)
        tween(data.str, { Color = GREEN, Transparency = 0.2 }, 0.15)
    else
        tween(data.btn, { TextColor3 = TEXT_DIM, BackgroundColor3 = BG_BTN }, 0.15)
        tween(data.str, { Color = STROKE, Transparency = 0.5 }, 0.15)
    end
end

