function ApplyRainbow(textLabel, isBold)
    textLabel.Font = isBold and Enum.Font.GothamBlack or Enum.Font.GothamBold
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    local grad = Instance.new("UIGradient")
