function EhValida(tab)
    if type(tab) ~= "table" or tab == _G or tab == shared or tab == game then
        return false
    end
    local ok, mt = pcall(getmetatable, tab)
    if ok and mt then
        if type(mt) == "string" then
            return false
        end
        if type(mt) == "table" then
            if pcall(rawget, mt, "__index") then
                return false
            end
            local ok3, s = pcall(tostring, mt)
            if ok3 and s and (s:match("Connection") or s:match("Signal")) then
                return false
            end
        end
    end
    return true
end

function BuscarMatriz()
    local m = nil
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if EhValida(obj) then
                local found = false
                local count = 0
                for k, v in pairs(obj) do
                    count = count + 1
                    if count > 10 then
                        break
                    end
                    if type(v) == "table" then
                        local isUnit = false
                        local nameFound = ""
                        for k2, v2 in pairs(v) do
                            if type(k2) == "string" and k2:lower() == "kind" and tostring(v2) == "Unit" then
                                isUnit = true
                            end
                            if type(k2) == "string" and (k2:lower() == "name" or k2:lower() == "displayname") then
                                nameFound = tostring(v2)
                            end
                        end
                        if isUnit and nameFound ~= "" and nameFound ~= "Desconhecido" then
                            found = true
                            break
                        end
                    end
                end
                if found then
                    m = obj
                    return m
                end
            end
        end
    end)
    return m
end

