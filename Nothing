end

local function encontrarRota(origem, destino)
    local tentativas = {4.5, 2.0, 1.0, 0.5}
    for _, radius in ipairs(tentativas) do
        local agentParams = {
            AgentRadius = radius,
            AgentHeight = 5,
            AgentCanJump = false,
            AgentCanClimb = false,
            WaypointSpacing = 4,
        }
        local path = PathfindingService:CreatePath(agentParams)
        local success = pcall(function() path:ComputeAsync(origem, destino) end)
        if success and path.Status == Enum.PathStatus.Success then
            return path
        end
    end
    return nil
end

local function moverComPathfinding(destino)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distancia = (hrp.Position - destino).Magnitude
    local tempoTotal = 0.6
    if distancia > 150 then tempoTotal = 1.4 end

    local listaPontos = {}
    local usarPontoPassagem = false

    if distancia > 100 then
        local distPontoPassagem = (destino - pontoPassagem).Magnitude
        if distPontoPassagem < 150 then
            usarPontoPassagem = true
        end
    end

    if usarPontoPassagem then
        local path1 = encontrarRota(hrp.Position, pontoPassagem)
        if path1 then
            local wp1 = path1:GetWaypoints()
            for _, wp in ipairs(wp1) do table.insert(listaPontos, wp) end
        end
        local path2 = encontrarRota(pontoPassagem, destino)
        if path2 then
            local wp2 = path2:GetWaypoints()
            for i = 2, #wp2 do table.insert(listaPontos, wp2[i]) end
        end
    else
        local pathNormal = encontrarRota(hrp.Position, destino)
        if pathNormal then
            local wps = pathNormal:GetWaypoints()
            for _, wp in ipairs(wps) do table.insert(listaPontos, wp) end
        end
    end

    if #listaPontos > 1 then
        local numPontos = #listaPontos
        local cframeValue = Instance.new("CFrameValue")
        cframeValue.Value = hrp.CFrame
        local conn = cframeValue:GetPropertyChangedSignal("Value"):Connect(function()
            if hrp then hrp.CFrame = cframeValue.Value end
        end)
        
        local tempoInicio = tick()
        local connection
        connection = RunService.RenderStepped:Connect(function()
            task.wait(0.03) 
            
            local tempoDecorrido = tick() - tempoInicio
            local porcentagem = math.clamp(tempoDecorrido / tempoTotal, 0, 1)
            
            if porcentagem >= 1 then
                hrp.CFrame = CFrame.new(listaPontos[numPontos].Position + Vector3.new(0, 1, 0))
                connection:Disconnect()
                return
            end
            
            local progressoFalso = porcentagem * (numPontos - 1)
            local indiceAtual = math.floor(progressoFalso) + 1
            local fator = progressoFalso - math.floor(progressoFalso)
            
            if indiceAtual >= numPontos then indiceAtual = numPontos - 1; fator = 1 end
            
            local pA = listaPontos[indiceAtual].Position + Vector3.new(0, 1, 0)
            local pB = listaPontos[indiceAtual + 1].Position + Vector3.new(0, 1, 0)
            local posAtual = pA:Lerp(pB, fator)
            
            local lookAt = CFrame.lookAt(posAtual, pB)
            hrp.CFrame = CFrame.new(posAtual) * lookAt.Rotation
        end)
        
        task.wait(tempoTotal)
        
        if connection then connection:Disconnect() end
        
        local posFinal = listaPontos[numPontos].Position + Vector3.new(0, 1, 0)
        hrp.CFrame = CFrame.new(posFinal)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        conn:Disconnect()
        cframeValue:Destroy()
        
        task.wait(0.1)
        return (hrp.Position - destino).Magnitude < 20
    else
        local tempoEmergencia = math.clamp(distancia / 100, 0.5, 2.0)
        local tweenInfo = TweenInfo.new(tempoEmergencia, Enum.EasingStyle.Linear)
        local targetPos = destino + Vector3.new(0, 1, 0)
        
        hrp.CanCollide = false
        local tween = TweenService:Create(hrp, tweenInfo, { CFrame = CFrame.new(targetPos) })
        tween:Play()
        tween.Completed:Wait()
        
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CanCollide = true
        
        task.wait(0.1)
        return (hrp.Position - destino).Magnitude < 20
    end
end

local casasVisitadasRodada = {}
local tempoEsperaReset = 0

local function LoopDoors()
    task.spawn(function()
        while isAutoTPRunning do
            task.wait(0.1)

            if not workspace:FindFirstChild("Halloween") then
                task.wait(1)
                continue
            end

            if tick() - lastTeleportTime <= TEMPO_ENTRE_CASAS then
                continue
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                task.wait()
                continue
            end

            local allSigns = findAllSigns()
            local ativos = {}

            for _, data in ipairs(allSigns) do
                pcall(function()
                    if data.attachment.Parent and data.titleLabel.Parent then
                        local txt = data.titleLabel.Text or ""
                        local lower = string.lower(txt)
                        local normalizado = lower:gsub("[^%a%s]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                        
                        if normalizado == "trick or treat" then
                            local pos = getSignPosition(data.attachment)
                            if pos then
                                local dist = (hrp.Position - pos).Magnitude
                                if dist > 20 then
                                    local chave = tostring(math.floor(pos.X)) .. "_" .. tostring(math.floor(pos.Z))
                                    if not casasVisitadasRodada[chave] then
                                        table.insert(ativos, { pos = pos, dist = dist, chave = chave })
                                    end
                                end
                            end
                        end
                    end
                end)
            end

            if #ativos == 0 then
                if #allSigns > 0 then
                    casasVisitadasRodada = {}
                end
                continue
            end

            table.sort(ativos, function(a, b) return a.dist < b.dist end)
            local alvo = ativos[1]

            local targetCoord = getClosestFixedCoord(alvo.pos)
            if targetCoord then
                local sucesso = moverComPathfinding(targetCoord)
                if sucesso then
                    casasVisitadasRodada[alvo.chave] = true
                end
                lastTeleportTime = tick()
            end
        end
    end)
end

