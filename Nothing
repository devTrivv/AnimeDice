local function getSignPosition(s)
    if s:IsA("Attachment") then
        local ok, p = pcall(function() return s.WorldPosition end)
        if ok and p and p.Magnitude > 0 then return p end
    end
    if s:IsA("Attachment") and s.Parent and s.Parent:IsA("BasePart") then
        local ok, p = pcall(function() return (s.Parent.CFrame * s.CFrame).Position end)
        if ok then return p end
    end
end

local function getClosestFixedCoord(p)
    local c, d = nil, math.huge
    for _, coord in ipairs(fixedCoords) do
        local dist = (coord - p).Magnitude
        if dist < d then d = dist; c = coord end
    end
    return c
end

local function findAllSigns()
    local f = {}
    for _, obj in pairs(workspace.Terrain:GetDescendants()) do
        if obj.Name == "TrickOrTreatSign" and obj:IsA("Attachment") then
            local b = obj:FindFirstChild("TrickOrTreatSign")
            if b and b:FindFirstChild("Content") then
                local t = b.Content:FindFirstChild("Title")
                if t and t:IsA("TextLabel") then table.insert(f, { attachment = obj, titleLabel = t }) end
            end
        end
