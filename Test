local function imagemDiscord(url, prefixo)
    if not url or url == "" then return nil end
    if cacheImg[url] then return cacheImg[url] end
    contador = contador + 1
    local ok, res = pcall(function()
        local arq = prefixo .. contador .. ".png"
        writefile(arq, game:HttpGet(url))
        return getcustomasset(arq)
    end)
    if ok and res then cacheImg[url] = res; return res end
    return nil
end

local function resolverURLAsset(asset, appId)
    if not asset or asset == "" then return nil end
    if string.find(asset, "spotify:") then
        return "https://i.scdn.co/image/" .. string.gsub(asset, "spotify:", "")
    end
    if string.find(asset, "^https?://") then return asset end
    if string.find(asset, "^mp:") then
        return "https://media.discordapp.net/" .. string.gsub(asset, "^mp:", "")
    end
    if appId then
        return "https://cdn.discordapp.com/app-assets/" .. tostring(appId) .. "/" .. asset .. ".png"
    end
    return nil
end

local function obterLogoRP(act)
    if not act or not act.assets then return nil end
    local tentativas = {}
    if act.assets.large_image then table.insert(tentativas, act.assets.large_image) end
    if act.assets.small_image then table.insert(tentativas, act.assets.small_image) end
    for _, asset in ipairs(tentativas) do
        local url = resolverURLAsset(asset, act.application_id)
        if url then
            local img = imagemDiscord(url, "dc_rp_")
            if img then return img end
        end
    end
    return nil
end

