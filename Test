local function EhValida(tab)
    if type(tab) ~= "table" then return false end
    if tab == _G or tab == shared or tab == game then return false end
    local ok, mt = pcall(getmetatable, tab)
    if ok and mt then
        if type(mt) == "string" then return false end
        if type(mt) == "table" then
            local ok2, idx = pcall(rawget, mt, "__index")
            if ok2 and idx then return false end
            local ok3, s = pcall(tostring, mt)
            if ok3 and s and (s:match("Connection") or s:match("Signal")) then return false end
        end
    end
    return true
end

local function BuscarMatriz()
    local matrizFinal = nil
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if EhValida(obj) then
                local temNomeReal = false
                local count = 0
                for k, v in pairs(obj) do
                    count = count + 1
                    if count > 10 then break end
                    if type(v) == "table" then
                        local isUnit = false
                        local nameFound = ""
                        for k2, v2 in pairs(v) do
                            if type(k2) == "string" and k2:lower() == "kind" and tostring(v2) == "Unit" then
                                isUnit = true
                            end
                            if type(k2) == "string" and (k2:lower() == "name" or k2:lower() == "displayname") then
                                nameFound = tostring(v2)
                            end
                        end
                        if isUnit and nameFound ~= "" and nameFound ~= "Desconhecido" then
                            temNomeReal = true
                            break
                        end
                    end
                end
                if temNomeReal then
                    matrizFinal = obj
                    return
                end
            end
        end
    end)
    return matrizFinal
end

local function LerQuirkDoBoneco(dadosBoneco)
    if type(dadosBoneco) ~= "table" then return nil end
    local resultado = nil
    pcall(function()
        for k, v in pairs(dadosBoneco) do
            if type(k) == "string" and k:lower():find("quirk") then
                if type(v) == "string" and v ~= "" then resultado = v; return end
                if type(v) == "table" then
                    for k2, v2 in pairs(v) do
                        if type(k2) == "string" and k2:lower() == "quirk" and type(v2) == "string" then
                            resultado = v2; return
                        end
                    end
                    if type(v.Name) == "string" then resultado = v.Name; return end
                    if type(v.name) == "string" then resultado = v.name; return end
                end
            end
        end
    end)
    if resultado then return resultado end
    pcall(function()
        for _, v in pairs(dadosBoneco) do
            if type(v) == "table" and v ~= dadosBoneco then
                for k2, v2 in pairs(v) do
                    if type(k2) == "string" and k2:lower():find("quirk") then
                        if type(v2) == "string" and v2 ~= "" then
                            resultado = v2
                            return
                        end
                    end
                end
            end
        end
    end)
    return resultado
end

local function AcharMinhaPlot()
    local Plots = workspace:FindFirstChild("Plots")
    if not Plots then return nil end
    local Claimed = Plots:FindFirstChild("Claimed")
    if not Claimed then return nil end
    for _, plot in pairs(Claimed:GetChildren()) do
        local label = plot:FindFirstChild("Label")
        if label then
            local billboard = label:FindFirstChild("BillboardGui")
            if billboard then
                local playerNameLabel = billboard:FindFirstChild("PlayerName")
                if playerNameLabel and playerNameLabel:IsA("TextLabel") then
                    if playerNameLabel.Text == LocalPlayer.DisplayName or playerNameLabel.Text == LocalPlayer.Name then
                        return plot
                    end
                end
            end
        end
        local owner = plot:FindFirstChild("Owner")
        if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then return plot end
        if plot:GetAttribute("OwnerId") == LocalPlayer.UserId then return plot end
    end
    return nil
end

local function GetMaxSlots()
    local minhaPlot = AcharMinhaPlot()
    if not minhaPlot then return 18 end
    local SlotsFolder = minhaPlot:FindFirstChild("Slots")
    if not SlotsFolder then return 18 end
    local maiorSlot = 0
    for _, slotObj in pairs(SlotsFolder:GetChildren()) do
        local num = tonumber(slotObj.Name)
        if num and num > maiorSlot then maiorSlot = num end
    end
    return maiorSlot > 0 and maiorSlot or 18
end

local function SlotPreenchido(slotNumero)
    local minhaPlot = AcharMinhaPlot()
    if not minhaPlot then return false end
    local SlotsFolder = minhaPlot:FindFirstChild("Slots")
    if not SlotsFolder then return false end
    local slotObj = SlotsFolder:FindFirstChild(tostring(slotNumero))
    if slotObj and #slotObj:GetChildren() > 0 then return true end
    return false
end

