-- REMOTE HELPER SEGURO (FindFirstChild primeiro, WaitForChild curto)
-- ============================================================
local function getRemote(path, timeout)
    timeout = timeout or 1.5
    local ok, res = pcall(function()
        local cur = ReplicatedStorage
        for i, seg in ipairs(path) do
            if not cur then return nil end
            local child = cur:FindFirstChild(seg)
            if not child and i == #path then
                child = cur:WaitForChild(seg, timeout)
            elseif not child then
                child = cur:WaitForChild(seg, timeout)
            end
            if not child then return nil end
            cur = child
        end
        return cur
    end)
    if ok then return res end
    return nil
end

