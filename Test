-- Animação de largura
local currentTargetWidth = WIDTH_NORMAL
local isAnimatingWidth = false
local function animateWidth(target)
    currentTargetWidth = target
    if isAnimatingWidth then return end
    isAnimatingWidth = true
    task.spawn(function()
        while math.abs(mainFrame.Size.X.Offset - currentTargetWidth) > 1 do
            local current = mainFrame.Size.X.Offset
            local newW = current + (currentTargetWidth - current) * 0.25
            if math.abs(newW - currentTargetWidth) < 1 then newW = currentTargetWidth end
            mainFrame.Size = UDim2.new(0, newW, 0, mainFrame.Size.Y.Offset)
            shadow.Size = UDim2.new(0, newW, 0, shadow.Size.Y.Offset)
            atualizarLayoutDiscord(newW)
            task.wait(0.02)
        end
        mainFrame.Size = UDim2.new(0, currentTargetWidth, 0, mainFrame.Size.Y.Offset)
        shadow.Size = UDim2.new(0, currentTargetWidth, 0, shadow.Size.Y.Offset)
        atualizarLayoutDiscord(currentTargetWidth)
        isAnimatingWidth = false
    end)
end

