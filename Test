local isEquipRunning = false
local MatrizSalva    = nil

local function EhValida(tab)
    if type(tab) ~= "table" or tab == _G or tab == shared or tab == game then
        return false
    end
    local ok, mt = pcall(getmetatable, tab)
    if ok and mt then
        if type(mt) == "string" then return false end
        if type(mt) == "table" then
            if pcall(rawget, mt, "__index") then return false end
            local ok3, s = pcall(tostring, mt)
            if ok3 and s and (s:match("Connection") or s:match("Signal")) then
                return false
            end
        end
    end
    return true
end

local function BuscarMatriz()
    local m = nil
    pcall(function()
        local gc = getgc and getgc(true)
        if not gc then return end
        for _, obj in pairs(gc) do
            if EhValida(obj) then
                local found = false
                local count = 0
                for k, v in pairs(obj) do
                    count = count + 1
                    if count > 10 then break end
                    if type(v) == "table" then
                        local isUnit = false
                        local nameFound = ""
                        for k2, v2 in pairs(v) do
                            if type(k2) == "string" and k2:lower() == "kind" and tostring(v2) == "Unit" then
                                isUnit = true
                            end
                            if type(k2) == "string" and (k2:lower() == "name" or k2:lower() == "displayname") then
                                nameFound = tostring(v2)
                            end
                        end
                        if isUnit and nameFound ~= "" and nameFound ~= "Desconhecido" then
                            found = true
                            break
                        end
                    end
                end
                if found then
                    m = obj
                    break
                end
            end
        end
    end)
    return m
end

local function LerQuirkDoBoneco(d)
    if type(d) ~= "table" then return nil end
    for k, v in pairs(d) do
        if type(k) == "string" and k:lower():find("quirk") then
            if type(v) == "string" and v ~= "" then return v end
            if type(v) == "table" then
                for k2, v2 in pairs(v) do
                    if type(k2) == "string" and k2:lower() == "quirk" and type(v2) == "string" then
                        return v2
                    end
                end
                if type(v.Name) == "string" then return v.Name end
                if type(v.name) == "string" then return v.name end
            end
        end
    end
    for _, v in pairs(d) do
        if type(v) == "table" and v ~= d then
            for k2, v2 in pairs(v) do
                if type(k2) == "string" and k2:lower():find("quirk") and type(v2) == "string" and v2 ~= "" then
                    return v2
                end
            end
        end
    end
    return nil
end

