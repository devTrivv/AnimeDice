local function IniciarAutoEquip(quirkEscolhida)
    local maxSlots = GetMaxSlots()
    if not MatrizSalva then
        setStatus("Matriz vazia!", RED); return
    end
    local EquipEvent        = getRemote({"Network", "UnitService", "RF", "Equip"}, 2)
    local InteractSlotEvent = getRemote({"Network", "PlotService", "RE", "InteractSlot"}, 2)
    if not EquipEvent or not InteractSlotEvent then
        setStatus("Remotes de equip faltando!", RED)
        isEquipRunning = false
        updateToggleVisual(autoEquipData, false, "AUTO EQUIP: ON", "AUTO EQUIP: OFF")
        return
    end
    local uuidsUsados = {}
    local slotAtual   = 1

    while slotAtual <= maxSlots and isEquipRunning do
        local minhaPlot = AcharMinhaPlot()
        if not minhaPlot then
            setStatus("Plot não encontrada...", RED)
            task.wait(1); continue
        end
        setStatus("Procurando p/ Slot " .. slotAtual, ACCENT_GLOW)
        local bonecoEncontrado = nil
        local targetLower = quirkEscolhida:lower()

        for chave, dados in pairs(MatrizSalva) do
            if type(dados) == "table" then
                local ehUnit = false
                pcall(function()
                    for k, v in pairs(dados) do
                        if tostring(k):lower() == "kind" and tostring(v) == "Unit" then
                            ehUnit = true; return
                        end
                    end
                end)
                if ehUnit then
                    local uuid = dados.key or dados.Key or (type(chave) == "string" and chave) or dados.UUID or dados.Id
                    local nome = dados.name or dados.Name
                    if uuid and nome then
                        uuid = tostring(uuid)
                        if not uuidsUsados[uuid] then
                            local q = LerQuirkDoBoneco(dados)
                            if q and q:lower() == targetLower then
                                bonecoEncontrado = { uuid = uuid, nome = tostring(nome) }
                                break
                            end
                        end
                    end
                end
            end
        end

        if not bonecoEncontrado then
            setStatus("Aguardando bonecos...", ACCENT_GLOW)
            task.wait(0.5)
        else
            local colocou, tentativas = false, 0
            while tentativas < 10 and isEquipRunning do
                tentativas = tentativas + 1
                setStatus(bonecoEncontrado.nome .. " -> Slot " .. slotAtual .. " (" .. tentativas .. ")", ACCENT_GLOW)
                pcall(function() EquipEvent:InvokeServer(bonecoEncontrado.uuid) end)
                task.wait(0.2)
                pcall(function() InteractSlotEvent:FireServer(slotAtual) end)
                local esperou = 0
                while esperou < 8 do
                    esperou = esperou + 1
                    task.wait(0.15)
                    if UUIDNoSlot(minhaPlot, slotAtual, bonecoEncontrado.uuid) then
                        colocou = true; break
                    end
                end
                if colocou then break end
                task.wait(0.2)
            end
            if colocou then
                uuidsUsados[bonecoEncontrado.uuid] = true
                setStatus("Slot " .. slotAtual .. " OK", GREEN)
                slotAtual = slotAtual + 1
            else
                setStatus("Desisti do Slot " .. slotAtual, RED)
                slotAtual = slotAtual + 1
            end
        end
    end
    isEquipRunning = false
    updateToggleVisual(autoEquipData, false, "AUTO EQUIP: ON", "AUTO EQUIP: OFF")
    if slotAtual > maxSlots then
        setStatus("Todos colocados!", GREEN)
    else
        setStatus("Parado.", TEXT_DIM)
    end
end

