local function fmtDecorrido(seg)
    seg = math.max(0, math.floor(seg))
    if seg < 60 then return seg .. "s" end
    if seg < 3600 then return string.format("%dm %ds", math.floor(seg/60), seg%60) end
    if seg < 86400 then return string.format("%dh %dm", math.floor(seg/3600), math.floor((seg%3600)/60)) end
    return string.format("%dd %dh", math.floor(seg/86400), math.floor((seg%86400)/3600))
end

