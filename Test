local function atualizarDiscord()
    local timestamp = DateTime.now().UnixTimestampMillis
    local url = "https://api.lanyard.rest/v1/users/" .. MeuDiscordID .. "?t=" .. timestamp

    local ok, resposta = pcall(function() return game:HttpGet(url, true) end)
    if not ok then return end

    local okJson, dados = pcall(function() return HttpService:JSONDecode(resposta) end)
    if not okJson or not dados.success then return end

    local d = dados.data
    local u = d.discord_user
    local st = STATUS[d.discord_status] or STATUS.offline

    if ultimoStatus == nil or ultimoStatus ~= d.discord_status then
        nLabel.Text = (u.global_name or u.display_name or u.username) .. " " .. st[3]
        tween(notifyGui, { Position = UDim2.new(0.5, -110, 0, 20) }, 0.4)
        task.delay(4, function()
            tween(notifyGui, { Position = UDim2.new(0.5, -110, 0, -50) }, 0.4)
        end)
    end
    ultimoStatus = d.discord_status

