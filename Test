btnAutoRotateTower.MouseButton1Click:Connect(function()
    if isAutoRotateTowerRunning then
        isAutoRotateTowerRunning = false
        btnAutoRotateTower.Text = "AUTO ROTATE: OFF"; btnAutoRotateTower.TextColor3 = Color3.fromRGB(180,90,90); btnAutoRotateTower.BackgroundColor3 = Color3.fromRGB(32,16,16); barTowerStroke.Color = STROKE
        setStatus("Auto Tower Desligado.", Color3.fromRGB(120,120,120))
        if cancelTowerRF then pcall(function() cancelTowerRF:InvokeServer() end) end
        return
    end
    isAutoRotateTowerRunning = true
    btnAutoRotateTower.Text = "AUTO ROTATE: ON"; btnAutoRotateTower.TextColor3 = ACCENT; btnAutoRotateTower.BackgroundColor3 = Color3.fromRGB(35,15,0); barTowerStroke.Color = ACCENT
    task.spawn(function()
        while isAutoRotateTowerRunning do
            local l = getListaTowersSelecionadas()
            if #l == 0 then setStatus("Nenhuma Tower selecionada!", Color3.fromRGB(255,50,50)); task.wait(2); continue end
            rotacaoTowerIndex = (rotacaoTowerIndex % #l) + 1
            local ct = l[rotacaoTowerIndex]
            if not completeTowerRF or not cancelTowerRF then setStatus("❌ Erro nos Remotes da Tower.", Color3.fromRGB(255,50,50)); isAutoRotateTowerRunning = false; break end
            local ptr = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Towers"):WaitForChild("RF"):WaitForChild("PlayTower")
            setStatus("🏰 Entrando: " .. ct, ACCENT)
            local entrou = false
            local tentativas = 0
            while isAutoRotateTowerRunning and not entrou and tentativas < 10 do
                tentativas = tentativas + 1
                pcall(function() entrou = (ptr:InvokeServer(ct) == true) end)
                if not entrou then setStatus("⏳ Recusado " .. tentativas .. "/10: " .. ct, Color3.fromRGB(255,200,0)); task.wait(1) end
            end
            if not entrou then setStatus("❌ Bloqueada: " .. ct, Color3.fromRGB(255,50,50)); task.wait(2); continue end
            task.wait(2); setStatus("⚔️ Lutando: " .. ct, Color3.fromRGB(255,200,0))
            torreFinalizada = false; ultimoFloor = 0; achouAndar = false
            while isAutoRotateTowerRunning and not torreFinalizada do
                pcall(function() completeTowerRF:InvokeServer() end)
                if achouAndar then achouAndar = false; setStatus("🏆 Floor " .. ultimoFloor, Color3.fromRGB(0,255,0)) end
                task.wait(1.5)
            end
            if isAutoRotateTowerRunning then setStatus("🏁 Torre finalizada...", Color3.fromRGB(255,200,0)); pcall(function() cancelTowerRF:InvokeServer() end); task.wait(1) end
        end
    end)
end)

