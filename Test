local currentTargetWidth, currentTargetHeight = WIDTH_NORMAL, HEIGHT_QUESTS
local isAnimatingSize = false
local isMinimized = false

local function animateSize(w, h)
    currentTargetWidth, currentTargetHeight = w, h
    if isAnimatingSize then return end
    isAnimatingSize = true
    task.spawn(function()
        while math.abs(mainFrame.Size.X.Offset - currentTargetWidth) > 1 or math.abs(mainFrame.Size.Y.Offset - currentTargetHeight) > 1 do
            local cw, ch = mainFrame.Size.X.Offset, mainFrame.Size.Y.Offset
            local nw = cw + (currentTargetWidth - cw) * 0.25
            local nh = ch + (currentTargetHeight - ch) * 0.25
            if math.abs(nw - currentTargetWidth) < 1 then nw = currentTargetWidth end
            if math.abs(nh - currentTargetHeight) < 1 then nh = currentTargetHeight end
            mainFrame.Size = UDim2.new(0, nw, 0, nh)
            shadowOuter.Size = UDim2.new(0, nw, 0, nh)
            shadowInner.Size = UDim2.new(0, nw, 0, nh)
            task.wait(0.02)
        end
        mainFrame.Size = UDim2.new(0, currentTargetWidth, 0, currentTargetHeight)
        shadowOuter.Size = UDim2.new(0, currentTargetWidth, 0, currentTargetHeight)
        shadowInner.Size = UDim2.new(0, currentTargetWidth, 0, currentTargetHeight)
        isAnimatingSize = false
    end)
end

local function setTab(id)
    currentTab = id
    for tid, data in pairs(tabButtons) do
        if tid == id then
            tween(data.btn, { BackgroundColor3 = HEADER_BG, TextColor3 = ACCENT_GLOW }, 0.2)
            tween(data.stroke, { Transparency = 0.15, Color = ACCENT }, 0.2)
        else
            tween(data.btn, { BackgroundColor3 = Color3.fromRGB(26, 18, 38), TextColor3 = TEXT_DIM }, 0.2)
            tween(data.stroke, { Transparency = 0.5, Color = STROKE }, 0.2)
        end
    end
    PageQuests.Visible = (id == "quests")
    PageEquip.Visible = (id == "equip")
    PageTower.Visible = (id == "tower")
    PageRoll.Visible = (id == "roll")
    if not isMinimized then
        if id == "quests" then animateSize(WIDTH_NORMAL, HEIGHT_QUESTS)
        else animateSize(WIDTH_EXPANDED, HEIGHT_TABS) end
    end
end

