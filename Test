local function SetPotion(state, isManual) States.Potion = state; if isManual then Manual.Potion = state end; updateVisual(state, BtnPotion, StrPotion) end

local function LoopDoors()
    task.spawn(function()
        while States.Doors do
            local HalloweenFolder = workspace:FindFirstChild("Halloween")
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChild("Humanoid")

            if HalloweenFolder and hrp and humanoid and humanoid.Health > 0 then
                for _, casa in ipairs(HalloweenFolder:GetChildren()) do
                    if not States.Doors then break end
                    if string.find(casa.Name, "HouseForTrickOrTreating") then
                        local door = casa:FindFirstChild("DoorOpener")
                        if door then
                            pcall(function()
                                hrp.CFrame = door:GetPivot()
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                            end)
                            task.wait(0.1)
                        end
                    end
                end
            else task.wait(0.5) end
        end
    end)
end

