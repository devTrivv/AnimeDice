            updateQuirkVisual(btn, str, lbl, circ, cstr, false)
        else
            SelectedLocks[q] = true
            updateQuirkVisual(btn, str, lbl, circ, cstr, true)
        end
    end)
end

-- Popula Equip (Single)
for i, q in ipairs(QUIRKS) do
    local btn, str, lbl, circ, cstr = criarBotaoQuirk(equipScroll, q, i)
    EquipButtons[q] = { btn = btn, str = str, lbl = lbl, circ = circ, cstr = cstr }
    btn.MouseButton1Click:Connect(function()
        if SelectedEquip == q then
            SelectedEquip = nil
            updateQuirkVisual(btn, str, lbl, circ, cstr, false)
        else
            SelectedEquip = q
            for _, q2 in ipairs(QUIRKS) do
                local b = EquipButtons[q2]
                if b then updateQuirkVisual(b.btn, b.str, b.lbl, b.circ, b.cstr, q2 == q) end
            end
        end
    end)
end

