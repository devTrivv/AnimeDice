local buffMonitorConnection = nil

local function checkHauntedPotion()
    if not workspace:FindFirstChild("Haunted Night") then return end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return end
    local root = pGui:FindFirstChild("Root")
    if not root then return end
    local hud = root:FindFirstChild("HUD")
    if not hud then return end
    local buffBar = hud:FindFirstChild("BuffBar")
    if not buffBar then return end

    local buffAtivo = buffBar:FindFirstChild("Boost_Haunted Potion")

    if not buffAtivo then
        local boostService = ReplicatedStorage:FindFirstChild("Network") and ReplicatedStorage.Network:FindFirstChild("BoostService")
        if boostService then
            local useRemote = boostService:FindFirstChild("RE") and boostService.RE:FindFirstChild("Use")
            if useRemote then
                pcall(function() useRemote:FireServer("Haunted Potion") end)
                setStatus("🧪 Poção Haunted Usada!", Color3.fromRGB(200, 100, 200))
            end
        end

        if not buffMonitorConnection then
            buffMonitorConnection = buffBar.ChildRemoved:Connect(function(child)
                if child.Name == "Boost_Haunted Potion" then
                    task.wait(0.5)
                    checkHauntedPotion()
                end
            end)
        end
    end
end

local function ProcessarHauntedNight()
    if workspace:FindFirstChild("Haunted Night") then
        if not States.PumpkinRoll then
            SetPumpkinRoll(true, true)
        end
        task.spawn(function()
            LoopPumpkinRoll()
        end)
        setStatus("🎃 Haunted Night Detectado! Auto Roll ON.", ACCENT)
        checkHauntedPotion()
    else
        if States.PumpkinRoll and not Manual.PumpkinRoll then
            SetPumpkinRoll(false, false)
            setStatus("⏸️ Haunted Night Sumiu.", Color3.fromRGB(120, 120, 120))
        end
        if buffMonitorConnection then
            buffMonitorConnection:Disconnect()
            buffMonitorConnection = nil
        end
    end
end

