local function IniciarAutoEquip(quirkEscolhida)
    local maxSlots = GetMaxSlots()
    if not MatrizSalva then
        setStatus("❌ Matriz vazia! Aguarde carregar e clique de novo.", Color3.fromRGB(255, 50, 50))
        return
    end

    local uuidsUsados = {}
    local slotAtual = 1
    local EquipEvent = ReplicatedStorage.Network.UnitService.RF.Equip
    local InteractSlotEvent = ReplicatedStorage.Network.PlotService.RE.InteractSlot

    while slotAtual <= maxSlots and isEquipRunning do
        setStatus("🔍 Procurando p/ Slot " .. slotAtual .. "...", ACCENT)
        local bonecoEncontrado = nil
        local targetLower = quirkEscolhida:lower()

        for chave, dados in pairs(MatrizSalva) do
            if type(dados) == "table" then
                local ehUnit = false
                pcall(function() for k, v in pairs(dados) do if tostring(k):lower() == "kind" and tostring(v) == "Unit" then ehUnit = true; return end end end)
                if ehUnit then
                    local uuid = dados.key or dados.Key or (type(chave) == "string" and chave) or dados.UUID or dados.Id
                    local nome = dados.name or dados.Name
                    if uuid and nome then
                        uuid = tostring(uuid)
                        if not uuidsUsados[uuid] then
                            local quirkAtual = LerQuirkDoBoneco(dados)
                            if quirkAtual and quirkAtual:lower() == targetLower then
                                bonecoEncontrado = { uuid = uuid, nome = nome }
                                break
                            end
                        end
                    end
                end
            end
        end

        if not bonecoEncontrado then
            setStatus("⏳ Aguardando bonecos...", ACCENT)
            task.wait(0.5)
        else
            uuidsUsados[bonecoEncontrado.uuid] = true
            setStatus("⚙️ Equipando: " .. bonecoEncontrado.nome, ACCENT)
            pcall(function() EquipEvent:InvokeServer(bonecoEncontrado.uuid) end)
            task.wait(0.2)
            setStatus("🗂️ Slot " .. slotAtual .. "/" .. maxSlots, ACCENT)
            pcall(function() InteractSlotEvent:FireServer(slotAtual) end)
            task.wait(0.1)
            if not SlotPreenchido(slotAtual) then
                setStatus("🔄 Retentando Slot " .. slotAtual, Color3.fromRGB(200, 200, 0))
                pcall(function() EquipEvent:InvokeServer(bonecoEncontrado.uuid) end)
                task.wait(0.3)
                pcall(function() InteractSlotEvent:FireServer(slotAtual) end)
                task.wait(0.4)
            end
            slotAtual = slotAtual + 1
        end
    end

    if slotAtual > maxSlots then setStatus("✅ all quirck selected placed!", Color3.fromRGB(0, 255, 0))
    else setStatus("⏸️ Parado.", Color3.fromRGB(120, 120, 125)) end
    isEquipRunning = false
end

