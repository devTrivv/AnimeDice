    ["DailyDoors"] = {"Daily","Doors"}, ["DailyFloors"] = {"Daily","Floors"}, ["DailyPotion"] = {"Daily","Potion"}, ["DailyRolls"] = {"Daily","Rolls"},
    ["HourlyFloors"] = {"Hourly","Floors"}, ["HourlyPotion"] = {"Hourly","Potion"}, ["HourlyPumpkinRolls"] = {"Hourly","PumpkinRolls"}, ["HourlyDice"] = {"Hourly","Dice"},
