oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and (self == GradeRollEvent or self == TraitRollEvent) then
        local args = {...}; local uuidRollado = args[1]
        task.delay(0.05, function() for _, item in ipairs(ListaItens) do if item.uuid == uuidRollado then item.atualizar(); break end end end)
