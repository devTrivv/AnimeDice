                        if sel then
                            local dados = nil
                            for _, d in pairs(MatrizSalva) do if type(d) == "table" and (d.key == uuid or d.Id == uuid) then dados = d; break end end
                            if dados and not CheckTraitMatch(LerTraitDoBoneco(dados)) then
                                task.spawn(function()
                                    while isAutoTraitRunning and not CheckTraitMatch(LerTraitDoBoneco(dados)) do pcall(function() TraitRollEvent:FireServer(uuid) end); task.wait(0.01) end
                                end)
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

