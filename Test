local function IniciarAutoEquip(quirkEscolhida)
    local maxSlots = GetMaxSlots()
    if not MatrizSalva then setStatus("❌ Matriz vazia! Aguarde carregar e clique de novo.", Color3.fromRGB(255,50,50)); return end
    local uuidsUsados = {}
    local slotAtual = 1
    local EquipEvent = ReplicatedStorage.Network.UnitService.RF.Equip
    local InteractSlotEvent = ReplicatedStorage.Network.PlotService.RE.InteractSlot
    while slotAtual <= maxSlots and isEquipRunning do
        local minhaPlot = AcharMinhaPlot()
        if not minhaPlot then setStatus("❌ Plot não encontrada, aguardando...", Color3.fromRGB(255,50,50)); task.wait(1); continue end
        setStatus("🔍 Procurando p/ Slot " .. slotAtual .. "...", ACCENT)
        local bonecoEncontrado = nil
        local targetLower = quirkEscolhida:lower()
        for chave, dados in pairs(MatrizSalva) do
            if type(dados) == "table" then
                local ehUnit = false
                pcall(function() for k, v in pairs(dados) do if tostring(k):lower() == "kind" and tostring(v) == "Unit" then ehUnit = true; return end end end)
                if ehUnit then
                    local uuid = dados.key or dados.Key or (type(chave) == "string" and chave) or dados.UUID or dados.Id
                    local nome = dados.name or dados.Name
                    if uuid and nome then
                        uuid = tostring(uuid)
                        if not uuidsUsados[uuid] then
                            local q = LerQuirkDoBoneco(dados)
                            if q and q:lower() == targetLower then bonecoEncontrado = { uuid = uuid, nome = nome }; break end
                        end
                    end
                end
            end
        end
        if not bonecoEncontrado then setStatus("⏳ Aguardando bonecos...", ACCENT); task.wait(0.5) else
            local colocou = false
            local tentativas = 0
            local MAX_TENTATIVAS = 10
            while tentativas < MAX_TENTATIVAS and isEquipRunning do
                tentativas = tentativas + 1
                setStatus("⚙️ " .. bonecoEncontrado.nome .. " → Slot " .. slotAtual .. " (tent " .. tentativas .. ")", ACCENT)
                pcall(function() EquipEvent:InvokeServer(bonecoEncontrado.uuid) end)
                task.wait(0.2)
                pcall(function() InteractSlotEvent:FireServer(slotAtual) end)
                local esperou = 0
                while esperou < 8 do
                    esperou = esperou + 1
                    task.wait(0.15)
                    if UUIDNoSlot(minhaPlot, slotAtual, bonecoEncontrado.uuid) then colocou = true; break end
                end
                if colocou then break end
                setStatus("🔄 UUID não no slot " .. slotAtual .. ", retentando...", Color3.fromRGB(200,200,0))
                task.wait(0.2)
            end
            if colocou then uuidsUsados[bonecoEncontrado.uuid] = true; setStatus("✅ Slot " .. slotAtual .. " OK", Color3.fromRGB(0,255,0)); slotAtual = slotAtual + 1
            else setStatus("❌ Desisti do Slot " .. slotAtual, Color3.fromRGB(255,50,50)); slotAtual = slotAtual + 1 end
        end
    end
    isEquipRunning = false
    SetEquipVisual(false)
    if slotAtual > maxSlots then setStatus("✅ all quirck selected placed!", Color3.fromRGB(0,255,0)) else setStatus("⏸️ Parado.", Color3.fromRGB(120,120,125)) end
end

