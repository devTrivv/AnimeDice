local function EhValida(tab)
    if type(tab) ~= "table" or tab == _G or tab == shared or tab == game then return false end
    local ok, mt = pcall(getmetatable, tab)
    if ok and mt then
        if type(mt) == "string" then return false end
        if type(mt) == "table" then
            if pcall(rawget, mt, "__index") then return false end
            local ok3, s = pcall(tostring, mt)
            if ok3 and s and (s:match("Connection") or s:match("Signal")) then return false end
        end
    end
    return true
end

local function BuscarMatriz()
    local m = nil
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if EhValida(obj) then
                local found = false
                local count = 0
                for k, v in pairs(obj) do
                    count = count + 1
                    if count > 10 then break end
                    if type(v) == "table" then
                        local isUnit = false
                        local nameFound = ""
                        for k2, v2 in pairs(v) do
                            if type(k2) == "string" and k2:lower() == "kind" and tostring(v2) == "Unit" then isUnit = true end
                            if type(k2) == "string" and (k2:lower() == "name" or k2:lower() == "displayname") then nameFound = tostring(v2) end
                        end
                        if isUnit and nameFound ~= "" and nameFound ~= "Desconhecido" then found = true; break end
                    end
                end
                if found then m = obj; return end
            end
        end
    end)
    return m
end

local function LerQuirkDoBoneco(d)
    if type(d) ~= "table" then return nil end
    local r = nil
    pcall(function()
        for k, v in pairs(d) do
            if type(k) == "string" and k:lower():find("quirk") then
                if type(v) == "string" and v ~= "" then r = v; return end
                if type(v) == "table" then
                    for k2, v2 in pairs(v) do
                        if type(k2) == "string" and k2:lower() == "quirk" and type(v2) == "string" then r = v2; return end
                    end
                    if type(v.Name) == "string" then r = v.Name; return end
                    if type(v.name) == "string" then r = v.name; return end
                end
            end
        end
    end)
    if r then return r end
    pcall(function()
        for _, v in pairs(d) do
            if type(v) == "table" and v ~= d then
                for k2, v2 in pairs(v) do
                    if type(k2) == "string" and k2:lower():find("quirk") and type(v2) == "string" and v2 ~= "" then r = v2; return end
                end
            end
        end
    end)
    return r
end

local function AcharMinhaPlot()
    local Plots = workspace:FindFirstChild("Plots")
    if not Plots then return nil end
    local Claimed = Plots:FindFirstChild("Claimed")
    if not Claimed then return nil end
    for _, plot in pairs(Claimed:GetChildren()) do
        local label = plot:FindFirstChild("Label")
        if label then
            local billboard = label:FindFirstChild("BillboardGui")
            if billboard then
                local playerNameLabel = billboard:FindFirstChild("PlayerName")
                if playerNameLabel and playerNameLabel:IsA("TextLabel") and (playerNameLabel.Text == LocalPlayer.DisplayName or playerNameLabel.Text == LocalPlayer.Name) then return plot end
            end
        end
        local owner = plot:FindFirstChild("Owner")
        if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then return plot end
        if plot:GetAttribute("OwnerId") == LocalPlayer.UserId then return plot end
    end
    return nil
end

local function GetMaxSlots()
    local p = AcharMinhaPlot()
    if not p then return 18 end
    local s = p:FindFirstChild("Slots")
    if not s then return 18 end
    local m = 0
    for _, o in pairs(s:GetChildren()) do local n = tonumber(o.Name); if n and n > m then m = n end end
    return m > 0 and m or 18
end

local function SlotPreenchido(n)
    local p = AcharMinhaPlot()
    if not p then return false end
    local s = p:FindFirstChild("Slots")
    if not s then return false end
    local o = s:FindFirstChild(tostring(n))
    return o and #o:GetChildren() > 0
end

local function UUIDNoSlot(plot, slotNum, uuid)
    if not plot then return false end
    local slots = plot:FindFirstChild("Slots")
    if not slots then return false end
    local slotObj = slots:FindFirstChild(tostring(slotNum))
    if not slotObj then return false end
    for _, filho in ipairs(slotObj:GetChildren()) do
        if tostring(filho.Name) == tostring(uuid) then return true end
    end
    return false
end

