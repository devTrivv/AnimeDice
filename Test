        for _, obj in pairs(terrain:GetDescendants()) do
            if obj.Name == "TrickOrTreatSign" and obj:IsA("Attachment") then
                local b = obj:FindFirstChild("TrickOrTreatSign")
                if b and b:FindFirstChild("Content") then
                    local t = b.Content:FindFirstChild("Title")
                    if t and t:IsA("TextLabel") then
                        table.insert(f, { attachment = obj, titleLabel = t })
                    end
                end
            end
        end
    end)
    return f
end

local function encontrarRota(origem, destino)
    for _, r in ipairs({4.5, 2.0, 1.0, 0.5}) do
        local ok, path = pcall(function()
            local p = PathfindingService:CreatePath({
                AgentRadius   = r,
                AgentHeight   = 5,
                AgentCanJump  = false,
                WaypointSpacing = 4
            })
            p:ComputeAsync(origem, destino)
            return p
        end)
        if ok and path and path.Status == Enum.PathStatus.Success then
            return path
        end
    end
    return nil
end

local function moverComPathfinding(destino)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local dist = (hrp.Position - destino).Magnitude
    local tempo = dist > 150 and 1.4 or 0.6
    local lista = {}

    if dist > 100 and (destino - pontoPassagem).Magnitude < 150 then
        local p1 = encontrarRota(hrp.Position, pontoPassagem)
        if p1 then
            for _, w in ipairs(p1:GetWaypoints()) do table.insert(lista, w) end
        end
        local p2 = encontrarRota(pontoPassagem, destino)
        if p2 then
            local w2 = p2:GetWaypoints()
            for i = 2, #w2 do table.insert(lista, w2[i]) end
        end
    else
        local p = encontrarRota(hrp.Position, destino)
        if p then
            for _, w in ipairs(p:GetWaypoints()) do table.insert(lista, w) end
        end
    end

    if #lista > 1 then
        local t0 = tick()
        local conn = RunService.RenderStepped:Connect(function()
            if not hrp or not hrp.Parent then return end
            local pct = math.clamp((tick() - t0) / tempo, 0, 1)
            if pct >= 1 then return end
            local fake = pct * (#lista - 1)
            local idx = math.floor(fake) + 1
            local f = fake - math.floor(fake)
            if idx >= #lista then idx = #lista - 1; f = 1 end
            local pA = lista[idx].Position + Vector3.new(0, 1, 0)
            local pB = lista[idx + 1].Position + Vector3.new(0, 1, 0)
            local pos = pA:Lerp(pB, f)
            pcall(function()
                hrp.CFrame = CFrame.new(pos) * CFrame.lookAt(pos, pB).Rotation
            end)
        end)
        local tEnd = tick() + tempo + 0.3
        while tick() < tEnd do task.wait(0.03) end
        if conn then conn:Disconnect() end
        pcall(function()
            hrp.CFrame = CFrame.new(lista[#lista].Position + Vector3.new(0, 1, 0))
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        task.wait(0.1)
        return (hrp.Position - destino).Magnitude < 20
    else
        local target = destino + Vector3.new(0, 1, 0)
        hrp.CanCollide = false
        local tw = TweenService:Create(hrp, TweenInfo.new(math.clamp(dist / 100, 0.5, 2.0)), { CFrame = CFrame.new(target) })
        tw:Play()
        tw.Completed:Wait()
        pcall(function()
            hrp.CFrame = CFrame.new(target)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        hrp.CanCollide = true
        task.wait(0.1)
        return (hrp.Position - destino).Magnitude < 20
    end
end

-- ============================================================
-- LOOP DOORS
-- ============================================================
local casasVisitadas = {}
local doorsLoopRunning = false

local function LoopDoors()
    if doorsLoopRunning then return end
    doorsLoopRunning = true
    task.spawn(function()
        while isAutoTPRunning do
            task.wait(0.1)
            local halloween = workspace:FindFirstChild("Halloween")
            if not halloween or tick() - lastTeleportTime <= TEMPO_ENTRE_CASAS then
                continue
            end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.5); continue end
            local ativos = {}
            for _, d in ipairs(findAllSigns()) do
                if d.attachment.Parent and d.titleLabel.Parent then
                    local titulo = string.lower(d.titleLabel.Text or "")
                    titulo = titulo:gsub("[^%a%s]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                    if titulo == "trick or treat" then
                        local pos = getSignPosition(d.attachment)
                        if pos and (hrp.Position - pos).Magnitude > 20 then
                            local chave = tostring(math.floor(pos.X)) .. "_" .. tostring(math.floor(pos.Z))
                            if not casasVisitadas[chave] then
                                table.insert(ativos, { pos = pos, dist = (hrp.Position - pos).Magnitude, chave = chave })
                            end
                        end
                    end
                end
            end
            if #ativos == 0 then
                casasVisitadas = {}
                task.wait(0.5)
                continue
            end
            table.sort(ativos, function(a, b) return a.dist < b.dist end)
            local c = nil
            local d = math.huge
            for _, coord in ipairs(fixedCoords) do
                if (coord - ativos[1].pos).Magnitude < d then
                    d = (coord - ativos[1].pos).Magnitude
                    c = coord
                end
            end
            if c then
                if moverComPathfinding(c) then
                    casasVisitadas[ativos[1].chave] = true
                end
                lastTeleportTime = tick()
            end
        end
        doorsLoopRunning = false
    end)
end

local function EstaNoEvento()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local h = workspace:FindFirstChild("Halloween")
    if not h or not hrp then return false end
    for _, obj in pairs(h:GetDescendants()) do
        if obj:IsA("BasePart") and (hrp.Position - obj.Position).Magnitude < 150 then
            return true
        end
    end
    return false
end

