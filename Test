local function makeToggleButton(parent, text, posY, height)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, height or 26)
    b.Position = UDim2.new(0, 8, 0, posY)
    b.BackgroundColor3 = BG_BTN
    b.Text = text
    b.TextColor3 = TEXT_DIM
    b.TextSize = 9
    b.Font = Enum.Font.GothamBold
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = 5
    b.Parent = parent
    makeCorner(b, 7)
    local s = makeStroke(b, STROKE, 1, 0.45)
    b.MouseEnter:Connect(function()
        if not b:GetAttribute("Active") then
            tween(b, { BackgroundColor3 = BG_BTN_HOVER }, 0.15)
        else
            tween(b, { BackgroundColor3 = BG_BTN_ON_HOV }, 0.15)
        end
    end)
    b.MouseLeave:Connect(function()
        if not b:GetAttribute("Active") then
            tween(b, { BackgroundColor3 = BG_BTN }, 0.15)
        else
            tween(b, { BackgroundColor3 = BG_BTN_ON }, 0.15)
        end
    end)
    return { btn = b, stroke = s }
end

local function updateToggleVisual(data, isOn, textOn, textOff)
    if not data or not data.btn then return end
    data.btn:SetAttribute("Active", isOn)
    if isOn then
        tween(data.btn, { BackgroundColor3 = BG_BTN_ON, TextColor3 = GREEN }, 0.2)
        if data.stroke then tween(data.stroke, { Color = GREEN, Transparency = 0.2 }, 0.2) end
        data.btn.Text = textOn
    else
        tween(data.btn, { BackgroundColor3 = BG_BTN, TextColor3 = TEXT_DIM }, 0.2)
        if data.stroke then tween(data.stroke, { Color = STROKE, Transparency = 0.45 }, 0.2) end
        data.btn.Text = textOff
    end
end

