-- Popula Lock (Multi)
for i, q in ipairs(QUIRKS) do
    local btn, str, lbl, circ, cstr = criarBotaoQuirk(lockScroll, q, i)
    LockButtons[q] = { btn = btn, str = str, lbl = lbl, circ = circ, cstr = cstr }
