local isClaimEnabled = false

local function dispararRemoteClaim(tipo, categoria, nomePasta)
    local Remote = ReplicatedStorage:FindFirstChild("Network") and ReplicatedStorage.Network:FindFirstChild("HalloweenQuestService") and ReplicatedStorage.Network.HalloweenQuestService:FindFirstChild("RE") and ReplicatedStorage.Network.HalloweenQuestService.RE:FindFirstChild("Claim")
    if Remote then
        local catSingular = string.gsub(categoria, "s$", "")
        if catSingular ~= categoria then
            setStatus("Claim: " .. nomePasta .. " (P/S)", Color3.fromRGB(0, 255, 0))
            pcall(function() Remote:FireServer(tipo, categoria) end)
            pcall(function() Remote:FireServer(tipo, catSingular) end)
        else
            setStatus("Claim: " .. nomePasta, Color3.fromRGB(0, 255, 0))
            pcall(function() Remote:FireServer(tipo, categoria) end)
        end
    end
end

local TraduzirMissao = {
    ["DailyDoors"] = {"Daily", "Doors"}, ["DailyFloors"] = {"Daily", "Floors"},
    ["DailyPotion"] = {"Daily", "Potion"}, ["DailyRolls"] = {"Daily", "Rolls"},
    ["HourlyFloors"] = {"Hourly", "Floors"}, ["HourlyPotion"] = {"Hourly", "Potion"},
    ["HourlyPumpkinRolls"] = {"Hourly", "PumpkinRolls"}, ["HourlyDice"] = {"Hourly", "Dice"},
    ["DailyDice"] = {"Daily", "Dice"}, ["HourlyDoors"] = {"Hourly", "Doors"}
}

local function AvaliarScrollingFrame(scroll)
    if not isCompleteEnabled and not isClaimEnabled then return end
    local precisaDoor, precisaPumpkin, precisaNormal, precisaPot = false, false, false, false
    for _, missaoFrame in ipairs(scroll:GetChildren()) do
        if missaoFrame:IsA("Frame") then
            local nomePasta = missaoFrame.Name
            local questGoal = missaoFrame:FindFirstChild("QuestGoal")
            local buttonsFolder = missaoFrame:FindFirstChild("Buttons")
            local botaoClaim = buttonsFolder and buttonsFolder:FindFirstChild("Claim")
            if botaoClaim then
                local infoFrame = botaoClaim:FindFirstChild("Frame") and botaoClaim.Frame:FindFirstChild("Info")
                local textoBotao = infoFrame and infoFrame:FindFirstChild("TextLabel") and infoFrame.TextLabel.Text
                local isClaimedText = (textoBotao == "Claimed")

                if isClaimEnabled and botaoClaim.GuiState == Enum.GuiState.Idle then
                    if not isClaimedText and not botaoClaim:GetAttribute("AutoClaimed") then
                        botaoClaim:SetAttribute("AutoClaimed", true)
                        local tipo, categoria = string.match(nomePasta, "^(Daily)") or string.match(nomePasta, "^(Hourly)"), string.gsub(nomePasta, "^(Daily)", ""):gsub("^(Hourly)", "")
                        if TraduzirMissao[nomePasta] then tipo = TraduzirMissao[nomePasta][1]; categoria = TraduzirMissao[nomePasta][2] end
                        if tipo and categoria then dispararRemoteClaim(tipo, categoria, nomePasta) end
                    end
                end
                if isCompleteEnabled and botaoClaim.GuiState == Enum.GuiState.NonInteractable and textoBotao == "Claim" then
                    if questGoal and questGoal:IsA("TextLabel") and questGoal.Text ~= "" then
                        local txt = string.lower(questGoal.Text)
                        if string.find(txt, "door") then precisaDoor = true
                        elseif string.find(txt, "pumpkin") then precisaPumpkin = true
                        elseif string.find(txt, "roll") or string.find(txt, "dice") then precisaNormal = true
                        elseif string.find(txt, "drink") or string.find(txt, "potion") then precisaPot = true
                        end
                    end
                end
            end
        end
    end
    if isCompleteEnabled then
        if precisaDoor and not States.Doors then SetDoors(true, false); LoopDoors() elseif not precisaDoor and States.Doors and not Manual.Doors then SetDoors(false, false) end
        if precisaPumpkin and not States.PumpkinRoll then SetPumpkinRoll(true, false); LoopPumpkinRoll() elseif not precisaPumpkin and States.PumpkinRoll and not Manual.PumpkinRoll then SetPumpkinRoll(false, false) end
        if precisaNormal and not States.NormalRoll then States.NormalRoll = true; LoopNormalRoll() elseif not precisaNormal and States.NormalRoll and not Manual.NormalRoll then States.NormalRoll = false end
        if precisaPot and not States.Potion then SetPotion(true, false); LoopPotion() elseif not precisaPot and States.Potion and not Manual.Potion then SetPotion(false, false) end
    endend

local function startSmartQuest()
    task.spawn(function()
        pcall(function()
            local pGui = LocalPlayer:WaitForChild("PlayerGui", 10)
            if not pGui then return end
            local hwQuests = pGui.Root.Menus.HalloweenQuests
            local questsFolder = hwQuests:WaitForChild("Quests", 10)
            local scrollingFrame = questsFolder and questsFolder:WaitForChild("ScrollingFrame", 5)
            if not scrollingFrame then return end
            scrollingFrame.ChildAdded:Connect(function() task.wait(0.5); AvaliarScrollingFrame(scrollingFrame) end)
            scrollingFrame.ChildRemoved:Connect(function() task.wait(0.5); AvaliarScrollingFrame(scrollingFrame) end)
            AvaliarScrollingFrame(scrollingFrame)
            task.spawn(function()
                while isCompleteEnabled or isClaimEnabled do
                    task.wait(1)
                    if scrollingFrame and scrollingFrame.Parent then AvaliarScrollingFrame(scrollingFrame) end
                end
            end)
        end)
    end)
end

