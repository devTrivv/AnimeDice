local TraduzirMissao = { ["DailyDoors"] = {"Daily","Doors"}, ["DailyFloors"] = {"Daily","Floors"}, ["DailyPotion"] = {"Daily","Potion"}, ["DailyRolls"] = {"Daily","Rolls"}, ["HourlyFloors"] = {"Hourly","Floors"}, ["HourlyPotion"] = {"Hourly","Potion"}, ["HourlyPumpkinRolls"] = {"Hourly","PumpkinRolls"}, ["HourlyDice"] = {"Hourly","Dice"}, ["DailyDice"] = {"Daily","Dice"}, ["HourlyDoors"] = {"Hourly","Doors"} }

local function AvaliarScrollingFrame(scroll)
    if not isCompleteEnabled and not isClaimEnabled then return end
    local pD, pP, pN, pPot = false, false, false, false
    for _, mf in ipairs(scroll:GetChildren()) do
        if mf:IsA("Frame") then
            local np = mf.Name; local qg = mf:FindFirstChild("QuestGoal"); local bf = mf:FindFirstChild("Buttons"); local bc = bf and bf:FindFirstChild("Claim")
            if bc then
                local inf = bc:FindFirstChild("Frame") and bc.Frame:FindFirstChild("Info"); local txt = inf and inf:FindFirstChild("TextLabel") and inf.TextLabel.Text; local isClaimed = (txt == "Claimed")
                if isClaimEnabled and bc.GuiState == Enum.GuiState.Idle and not isClaimed and not bc:GetAttribute("AutoClaimed") then
                    bc:SetAttribute("AutoClaimed", true)
                    local tipo, categoria = string.match(np, "^(Daily)") or string.match(np, "^(Hourly)"), string.gsub(np, "^(Daily)", ""):gsub("^(Hourly)", "")
                    if TraduzirMissao[np] then tipo = TraduzirMissao[np][1]; categoria = TraduzirMissao[np][2] end
                    if tipo and categoria then dispararRemoteClaim(tipo, categoria, np) end
                end
                if isCompleteEnabled and bc.GuiState == Enum.GuiState.NonInteractable and txt == "Claim" and qg and qg:IsA("TextLabel") and qg.Text ~= "" then
                    local t = string.lower(qg.Text)
                    if string.find(t, "door") then pD = true elseif string.find(t, "pumpkin") then pP = true elseif string.find(t, "roll") or string.find(t, "dice") then pN = true elseif string.find(t, "drink") or string.find(t, "potion") then pPot = true end
                end
            end
        end
    end
    if isCompleteEnabled then
        if pD and not States.Doors then SetDoors(true, false); LoopDoors() elseif not pD and States.Doors and not Manual.Doors then SetDoors(false, false) end
        if pP and not States.PumpkinRoll then SetPumpkinRoll(true, false); LoopPumpkinRoll() elseif not pP and States.PumpkinRoll and not Manual.PumpkinRoll then SetPumpkinRoll(false, false) end
        if pN and not States.NormalRoll then States.NormalRoll = true; LoopNormalRoll() elseif not pN and States.NormalRoll and not Manual.NormalRoll then States.NormalRoll = false end
        if pPot and not States.Potion then SetPotion(true, false); LoopPotion() elseif not pPot and States.Potion and not Manual.Potion then SetPotion(false, false) end
    end
end

