local ListaItens = {}
local function AtualizarLista()
    for _, v in ipairs(ListaItens) do v.frame:Destroy() end
    table.clear(ListaItens)
    if not MatrizSalva then return end
    local filtro = SearchBox.Text:lower()
    for chave, dados in pairs(MatrizSalva) do
        if type(dados) == "table" then
            local ehUnit = false
            for k, v in pairs(dados) do if tostring(k):lower() == "kind" and tostring(v) == "Unit" then ehUnit = true; break end end
            if ehUnit then
                local uuid = dados.key or dados.Key or (type(chave) == "string" and chave) or dados.Id
                local nome = dados.name or dados.Name or "?"
                if uuid and (filtro == "" or nome:lower():find(filtro, 1, true)) then
                    local itemFrame = Instance.new("Frame")
                    itemFrame.Size = UDim2.new(1, -2, 0, 32)
                    itemFrame.BackgroundColor3 = BG_BTN
                    itemFrame.Parent = ScrollLista
                    makeCorner(itemFrame, 6)
                    local is = makeStroke(itemFrame, STROKE, 1, 0.5)
                    local btnCheck = Instance.new("TextButton")
                    btnCheck.Size = UDim2.new(1, 0, 1, 0)
                    btnCheck.BackgroundTransparency = 1
                    btnCheck.Text = ""
                    btnCheck.Parent = itemFrame
                    local txtNome = Instance.new("TextLabel")
                    txtNome.Size = UDim2.new(1, -10, 0, 13)
                    txtNome.Position = UDim2.new(0, 6, 0, 3)
                    txtNome.BackgroundTransparency = 1
                    txtNome.Text = "☐ " .. nome
                    txtNome.TextColor3 = TEXT_BRIGHT
                    txtNome.TextSize = 9
                    txtNome.Font = Enum.Font.GothamBold
                    txtNome.TextXAlignment = Enum.TextXAlignment.Left
                    txtNome.Parent = itemFrame
                    local txtInfo = Instance.new("TextLabel")
                    txtInfo.Size = UDim2.new(1, -10, 0, 11)
                    txtInfo.Position = UDim2.new(0, 6, 0, 17)
                    txtInfo.BackgroundTransparency = 1
                    txtInfo.TextColor3 = TEXT_DIM
                    txtInfo.TextSize = 8
                    txtInfo.Font = Enum.Font.Gotham
                    txtInfo.TextXAlignment = Enum.TextXAlignment.Left
                    txtInfo.Parent = itemFrame
                    local function updateVisual()
                        local gAtual, tAtual = "?", "Sem Trait"
                        local att = dados.attributes or dados.Attributes
                        if type(att) == "table" then
                            gAtual = att.grade or "?"
                            tAtual = att.trait or "Sem Trait"
                        end
                        txtInfo.Text = "Grade: " .. gAtual .. "  |  Trait: " .. tAtual
                        if selectedBonecos[uuid] then
                            itemFrame.BackgroundColor3 = BG_BTN_ON
                            is.Color = GREEN
                            is.Transparency = 0.2
                            txtNome.Text = "☑ " .. nome
                            txtNome.TextColor3 = GREEN
                        else
                            itemFrame.BackgroundColor3 = BG_BTN
                            is.Color = STROKE
                            is.Transparency = 0.5
                            txtNome.Text = "☐ " .. nome
                            txtNome.TextColor3 = TEXT_BRIGHT
                        end
                    end
                    btnCheck.MouseButton1Click:Connect(function()
                        selectedBonecos[uuid] = not selectedBonecos[uuid]
                        updateVisual()
                    end)
                    table.insert(ListaItens, { frame = itemFrame, uuid = uuid, dados = dados, atualizar = updateVisual })
                    updateVisual()
                end
            end
        end
    end
end
